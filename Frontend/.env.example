# ==============================================================================
# BHUSENTRY Frontend Environment Configuration Example
# ==============================================================================
# Duplicate this file to '.env' and fill in your actual credentials.
# Command: cp .env.example .env

# Supabase Credentials (Required for authentication and live data subscriptions)
# Get these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# API Base URL
# In local development: /api/v1 (routed via Vite proxy to http://localhost:8000/api/v1)
# In production: https://your-backend-api-domain.com/api/v1 or /api/v1 if behind reverse proxy
VITE_API_BASE_URL=/api/v1

# Data and Feature Toggles
# Set to true to use static mock data if backend server is not running
VITE_ENABLE_MOCK_DATA=false

# Weather Provider Toggle
VITE_USE_OPEN_METEO=true

# Optional External Weather API (leave blank if using Open-Meteo)
VITE_OPENWEATHER_API_KEY=
