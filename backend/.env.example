# ==============================================================================
# BHUSENTRY Backend Environment Configuration Example
# ==============================================================================
# Duplicate this file to '.env' and fill in your actual credentials.
# Command: cp .env.example .env

# Application Configuration
PROJECT_NAME="BHUSENTRY Landslide Early Warning & Risk Monitoring System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Supabase Credentials (Required for Auth & PostgreSQL Database access)
# Get these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# External API Integrations

# Open-Meteo API (Free weather API; key is optional for standard usage, required for commercial/higher tier)
OPEN_METEO_API_KEY=""

# OpenTopography API (High-resolution DEM/Elevation data)
# Obtain a free API key at https://opentopography.org/
OPEN_TOPOGRAPHY_API_KEY="your-opentopography-api-key-here"

# AI Model Provider (xAI Grok AI Copilot & Weather Intelligence)
# Obtain API key from https://console.x.ai/
GROK_API_KEY="your-xai-grok-api-key-here"
XAI_API_KEY="your-xai-grok-api-key-here"

# Fallback AI Provider (Google Gemini)
# Obtain API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Indian Emergency Notification Gateway (Fast2SMS & Telegram)
# Fast2SMS: India's SMS gateway for +91 numbers (https://www.fast2sms.com)
FAST2SMS_API_KEY=""

# Telegram Emergency Alert Bot (Free instant push alerts)
# Create a bot via @BotFather on Telegram and get your chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
